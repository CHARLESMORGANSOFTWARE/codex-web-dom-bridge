{
  "name": "codex-web-dom-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local MCP browser bridge that lets Codex observe, act, wait, extract, search, and run workflows directly against the live DOM.",
  "bin": {
    "codex-web": "./bin/codex-web.mjs",
    "codex-web-mcp": "./bin/codex-web-mcp.mjs"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "demo": "node src/server.mjs --open-demo",
    "benchmark": "node scripts/benchmark.mjs",
    "mcp": "node bin/codex-web-mcp.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.1"
  }
}
