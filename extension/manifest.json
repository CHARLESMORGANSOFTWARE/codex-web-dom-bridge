{
  "manifest_version": 3,
  "name": "Codex DOM Bridge",
  "version": "0.1.0",
  "description": "Expose a tiny observe/act/wait/extract control plane over the live DOM.",
  "permissions": [],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:8797/*",
    "http://localhost:8797/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
